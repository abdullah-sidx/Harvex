# Sarvam AI API Key for Text-to-Speech (TTS) and Speech-to-Text (STT)
SARVAM_API_KEY="MY_SARVAM_API_KEY"

# Google Gemini API Key for AI features (disease, chat, recommendations)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="MY_APP_URL"

# FastAPI backend URL for frontend voice calls
VITE_BACKEND_URL="http://localhost:8000"

# Optional browser-side Sarvam STT key (keep server-side in production)
VITE_SARVAM_API_KEY="MY_SARVAM_API_KEY"

# Optional OpenWeatherMap API key
OPENWEATHER_API_KEY="MY_OPENWEATHER_API_KEY"

# Field location for weather queries
FIELD_LATITUDE="28.6139"
FIELD_LONGITUDE="77.2090"

# Irrigation decision thresholds
DRY_THRESHOLD="30.0"
RAIN_THRESHOLD="0.5"
MAX_PUMP_RUNTIME_SECONDS="30"

# Weather cache duration in seconds
WEATHER_CACHE_TTL="600"

# SQLite database path
HARVEX_DB_PATH="backend/harvex.db"

# Environment: development or production
NODE_ENV="development"

# Allowed CORS origins (comma-separated, leave empty for *)
ALLOWED_ORIGINS=""

# Rate limiting (requests per window / window seconds / burst / max backoff)
RATE_LIMIT_AUTH_REQUESTS="5"
RATE_LIMIT_AUTH_WINDOW="60"
RATE_LIMIT_AUTH_BURST="3"
RATE_LIMIT_AUTH_MAX_BACKOFF="300"
RATE_LIMIT_PUBLIC_REQUESTS="60"
RATE_LIMIT_PUBLIC_WINDOW="60"
RATE_LIMIT_PUBLIC_BURST="10"
RATE_LIMIT_PUBLIC_MAX_BACKOFF="60"
RATE_LIMIT_AUTHENTICATED_REQUESTS="30"
RATE_LIMIT_AUTHENTICATED_WINDOW="60"
RATE_LIMIT_AUTHENTICATED_BURST="5"
RATE_LIMIT_AUTHENTICATED_MAX_BACKOFF="120"

# File upload limits
MAX_FILE_SIZE_BYTES="10485760"
